{
  "exclude": [
    "**/test/fixtures/**",
    "examples/**",
    "packages/desktop/stage/**",
    "packages/desktop/release/**"
  ],
  "layers": [
    {
      "name": "language",
      "paths": [
        "packages/language/src/**"
      ],
      "mayImport": [],
      "style": "functional"
    },
    {
      "name": "extract",
      "paths": [
        "packages/extract/src/**"
      ],
      "mayImport": [
        "language"
      ],
      "style": "functional"
    },
    {
      "name": "server",
      "paths": [
        "packages/server/src/**"
      ],
      "mayImport": [
        "language",
        "extract"
      ],
      "style": "functional"
    },
    {
      "name": "app",
      "paths": [
        "packages/app/src/**"
      ],
      "mayImport": [
        "language"
      ],
      "style": "object-oriented"
    },
    {
      "name": "desktop",
      "paths": [
        "packages/desktop/src/**"
      ],
      "mayImport": [
        "server",
        "extract"
      ],
      "style": "object-oriented"
    },
    {
      "name": "vscode",
      "paths": [
        "packages/vscode/src/**"
      ],
      "mayImport": [],
      "style": "object-oriented"
    }
  ],
  "packageEntries": true,
  "patterns": [
    {
      "subject": "DiagramStore",
      "pattern": "singleton"
    },
    {
      "subject": "LiveLink",
      "pattern": "singleton"
    },
    {
      "subject": "NuxmvApi",
      "pattern": "singleton"
    },
    {
      "subject": "packages/language",
      "pattern": "facade"
    },
    {
      "subject": "packages/extract",
      "pattern": "facade"
    }
  ],
  "machines": {
    "App.tab": {
      "terminal": [
        "model",
        "attributes",
        "properties",
        "trace",
        "python",
        "console"
      ]
    },
    "HelpDialog.section": {
      "terminal": [
        "guide",
        "walkthroughs",
        "symbols",
        "glossary",
        "references"
      ]
    }
  },
  "languages": {
    "typescript": {
      "limits": {
        "functionLines": 50,
        "functionParams": 7
      },
      "complexity": {
        "cognitive": 15,
        "nesting": 4
      },
      "naming": {
        "class": "PascalCase",
        "function": "camelCase",
        "method": "camelCase",
        "field": "camelCase",
        "constant": "SCREAMING_SNAKE_CASE"
      }
    },
    "python": {
      "limits": {
        "functionLines": 50,
        "functionParams": 5
      },
      "complexity": {
        "cognitive": 15,
        "nesting": 5
      },
      "naming": {
        "class": "PascalCase",
        "function": "snake_case",
        "method": "snake_case",
        "field": "snake_case",
        "constant": "SCREAMING_SNAKE_CASE"
      }
    }
  },
  "duplication": {
    "minTokens": 100,
    "minLines": 10,
    "tests": false,
    "similarity": 0.8,
    "minFunctionTokens": 50
  },
  "ignore": [
    {
      "rule": "oop-mutates-foreign-object",
      "file": "packages/vscode/src/extension.ts",
      "reason": "VS Code hands activate() its ExtensionContext so that the extension adds its disposables to context.subscriptions; VS Code disposes them when it deactivates the extension. That is the API, not a foreign object changed behind its owner's back."
    },
    {
      "rule": "fp-mutable-global",
      "file": "packages/language/src/parse.ts",
      "reason": "Langium services are created once, on first use (memoised), and the counter only keeps the URIs of in-memory documents unique while several parses are in flight."
    },
    {
      "rule": "fp-writes-outer-state",
      "file": "packages/language/src/parse.ts",
      "reason": "Same memoised services and document counter as above."
    },
    {
      "rule": "fp-class",
      "subject": "PastTimeMonitor",
      "reason": "A runtime monitor is a state machine by nature: it keeps the previous values of the past-time subformulas."
    },
    {
      "rule": "fp-class",
      "file": "packages/extract/src/**",
      "reason": "Compiler-API visitors keep the context of one traversal; they are never shared."
    },
    {
      "rule": "oop-mutates-foreign-object",
      "subject": "token",
      "reason": "CodeMirror's StreamParser contract: token() advances the stream and updates the parser state it is given."
    },
    {
      "rule": "naming-convention",
      "file": "packages/language/src/state-diagram-module.ts",
      "reason": "Langium's dependency-injection modules name each service factory after the service class (ScopeComputation, StateDiagramValidator)."
    }
  ],
  "limits": {
    "classMethods": 30,
    "classLines": 600,
    "functionLines": 80
  },
  "baseline": "provenflow-baseline.json",
  "agents": {
    "failOn": "warning",
    "requireTests": true
  }
}
