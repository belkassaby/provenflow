{
  "name": "@provenflow/extract",
  "version": "0.1.0",
  "private": true,
  "description": "Extracts verifiable models from a code base (TypeScript, Python, Java, Kotlin, Groovy, Scala, C, C++, C#, Go, Rust, Swift, Ruby, PHP, R): state machines, resource lifecycles, design-pattern contracts, paradigm and architecture rules.",
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "files": [
    "out",
    "src",
    "grammars",
    "rules"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && cp src/python_facts.py out/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@provenflow/language": "0.1.0",
    "typescript": "~6.0.3",
    "web-tree-sitter": "0.25.10",
    "tree-sitter-wasms": "0.1.13",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.1"
  }
}
